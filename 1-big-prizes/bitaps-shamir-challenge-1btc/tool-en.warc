                                    <i class="fa fa-chevron-left mr-1 zoom-out"></i>Back to generation tools
                                </button>

                            </div>

                        </div>
                        <div style="font-size: 1em;"
                             class="w-100 d-flex flex-row justify-content-end mt-4 pr-2 mb-2">

                            <div class="btn-copy copy ml-4"
                                 data-toggle="tooltip" data-placement="top" title="Copy"
                                 onclick="copyDivClipboard(this, '#mnemonic-derive');"></div>
                            <div class="show-qr ml-4"
                                 data-toggle="tooltip" data-placement="top" title="Show qr-code"
                                 onclick="showQrcode('#mnemonic-derive', '#mnemonic-derive-qr');"></div>
                        </div>
                        <div id="mnemonic-derive"
                             class="textarea textare-disabled   w-100  mb-2 pr-2 text-justify"></div>
                        <div class="w-100 d-flex flex-row justify-content-center">
                            <canvas id="mnemonic-derive-qr" class="qrcode mt-2 mb-2"
                                    style="width: 20em; height: 20em;display: none;"></canvas>
                        </div>
                        <div id="mnemonic-option" class="mt-4 d-inline-block smaller pb-4">
                            <div class=" items d-flex  flex-row  align-items-center">
                                <div style="width:14em;font-size: 1.2em">Passphrase (optional)</div>
                                <div id="passphrase"
                                     onkeyup="pass_changed();"
                                     onpaste="pass_changed();"
                                     oninput="pass_changed();"
                                     contenteditable="true"
                                     type="password"
                                     onchange="pass_changed();" class="textarea textarea-disabled w-100 mt-2 mb-2"
                                     style="height: 2.45em;"></div>
                                <div class="items-btn ml-4 ">


                                    <button type="button" id="pass-btn" disabled onclick="apply_pass();"
                                            class=" btn btn-outline-secondary  ">Apply
                                    </button>
